# =====================================================================
# incar_3d.tpl -- step1 geometry optimization after standardization (elastic workflow) (3D bulk, ISIF=3 full-cell relaxation)
#
# placeholders (filled in by gen_step1, key names wrapped in double braces):
#   SYSTEM    from the POSCAR title / chemical formula
#   ENCUT     ceil(1.5 x max ENMAX in POTCAR), or MANUAL_ENCUT
#   GGA       decided by FUNC at the top (pbe / pbe-d3 -> PE, pbesol -> PS)
#   VDW_LINE  pbe-d3 -> "IVDW = 12", otherwise -> a comment line
# to pin a value by hand, just replace its placeholder with a number (the script only fills placeholders that actually appear in the template).
# other parameters may be added/removed/changed freely and are passed through verbatim; step2/3/4 inherit from the previous step and rewrite them per their own rules.
#
# [injected automatically, do not write in this template] ISPIN / MAGMOM / NUPDOWN / LMAXMIX / LDAU*
#   if written they are silently overridden; to change them, edit gen_step1's top-level config or the generated stepN/INCAR.
#
# [ISIF=3, must read] a negative EDIFFG checks forces only, not stress, so a single round necessarily carries Pulay stress.
#   after convergence, cp CONTCAR POSCAR and rerun until the lattice-constant change is < 0.001 Å (usually 2-3 rounds).
# =====================================================================

SYSTEM = Mn2In2Se5

# ---- Start / functional ----
ISTART = 0
ICHARG = 2
GGA    = PE
IVDW   = 12            # PBE + DFT-D3(BJ)
# GGA_COMPAT = .FALSE.    # optional: for low-symmetry / strongly anisotropic cells, restores rotational invariance of the gradient terms

# ---- Precision ----
PREC    = Accurate
ENCUT    = 540
LREAL   = .FALSE.
LASPH   = .TRUE.

# ---- Electronic steps ----
ALGO   = Normal
EDIFF  = 1E-7        # elastic: tightened to 1E-7 to serve the near-zero-stress ground state
NELM   = 100
NELMIN = 6
ISMEAR = 0                # semiconductor / insulator / unknown system
SIGMA  = 0.05
# for metals use: ISMEAR = 1 / SIGMA = 0.2 and check that OUTCAR's "entropy T*S" < 1 meV/atom
# do not use ISMEAR = -5 during relaxation (tetrahedron forces and stresses are unreliable); leave it for the step3/4 DOS

# ---- Ionic steps ----
IBRION   = 1
ISIF     = 3
ISYM   = 2                # keep the space group; set 0 to search for symmetry-broken phases (distortion/polarization)
POTIM    = 0.3
NSW      = 100
EDIFFG   = 1E-6

# ---- Output ----
LWAVE  = .FALSE.          # the cell changes during multi-round Pulay relaxation, so WAVECAR cannot be reused across rounds
LCHARG = .TRUE.

# ---- Parallelization ----
NCORE  = 6                # (total cores / KPAR) must be divisible by NCORE
KPAR   = 4                # memory about x4; the GPU (OpenACC) build requires NCORE = 1


# =====================================================================
# Appendix: quick parameter reference (comments only)
# =====================================================================
# ---- IBRION ----
# -1 static (with NSW=0) | 0 MD | 1 RMM-DIIS (fast to finish) | 2 CG (preferred, robust)
#  3 damped MD (last resort) | 5/6 finite-difference phonons | 7/8 DFPT
#
# ---- ISIF ----
#  2 relax atoms only | 3 atoms+shape+volume (this template) | 4 atoms+shape at fixed volume
#  6 shape+volume, atoms fixed | 7 volume only (equation of state / bulk modulus)
#
# ---- ISMEAR ----
#  0 Gaussian, SIGMA=0.05 -- semiconductors/insulators, the general safe choice
#  1 first-order MP, SIGMA=0.2 -- metal relaxation
# -5 tetrahedron+Blöchl -- accurate total energy and DOS, needs k-points >= 4, must not be used for relaxation
#
# ---- EDIFFG ----
# negative value = force criterion (eV/Å): -0.01 normally, -0.001 before phonons / high precision
# positive value = energy-difference criterion, rarely used
#
# ---- ISYM ----
#  2 default (PBE/PBEsol/SCAN relaxation, SCF, bands, DOS; also used for collinear spin)
#  3 symmetrize forces and stress only -- the default for hybrid functionals with LHFCALC=.T.
#  0 space group off -- MD / EFIELD / LDIPOL / LCALCPOL / SOC bands / symmetry breaking needed
# -1 fully off -- magnetocrystalline anisotropy MAE (all SAXIS must share one k-grid) / Wannier / topology
# note: with symmetry off the IBZ is no longer reduced and the k-point count can grow several-fold; avoid switching it off

# ---- Magnetism (decided automatically by gen_step1 from the POSCAR: magnetic candidate element Mn detected (high-spin FM start)) ----
ISPIN    = 2
MAGMOM   = 2*5  2*0  5*0

# ---- LMAXMIX (decided automatically by gen_step1 from the POSCAR: d elements In/Mn present) ----
LMAXMIX  = 4

# ---- DFT+U (decided automatically by gen_step1 from the POSCAR: add U for Mn (U=4, l=2)) ----
# * The U values below come from gen_step1's U_VALUES table and are a [common literature starting point],
#   not a verdict for your particular system -- always check the literature and adjust as needed!
#   option 1 (this run only): edit the LDAUU line below directly;
#   option 2 (new values from now on): change gen_step1's U_VALUES / U_OVERRIDE and rerun gen.
#   each column of LDAUL/LDAUU/LDAUJ corresponds in turn to one POSCAR species (same order as POTCAR);
#   LDAUL: 2=d orbital, 3=f orbital, -1=no U for that element (write 0 for its U/J).
#   LDAUTYPE=2 (Dudarev) uses only the effective U=U-J, so LDAUJ is always 0.
#   note: step2/step3 inherit these U values verbatim; whether step4 (HSE) keeps them is set by that script's
#   HSE_U_MODE (default remove = pure HSE06).
LDAU     = .TRUE.
LDAUTYPE = 2
LDAUL    = 2 -1 -1
LDAUU    = 4 0.0 0.0
LDAUJ    = 0.0 0.0 0.0
LDAUPRINT= 1
