# phonopy displaced-supercell single-point force run (3D). Hard phonon constraint: ISYM=0 (displacements break symmetry, do not symmetrize the forces).
# precision (aligned with kl-dft-cpu S4, the convention of phonopy's official supercell force example): PREC=Accurate, EDIFF=1E-7,
# LREAL=.FALSE.; the forces of the displaced frames become fc2 directly: the real-space projection of LREAL=Auto carries grid noise and is
# common source of spurious soft modes in fc. The three values come from step.conf's FORCE_PREC / FORCE_EDIFF / FORCE_LREAL.
# for very large supercells (hundreds of atoms) FORCE_LREAL=Auto can be traded for speed, but first, on 3 frames, against .FALSE.
# compare forces (max deviation < 1 meV/Å) and set ROPT explicitly. ADDGRID reduces grid noise in the forces.
SYSTEM  = phonon-dft-cpu force 00002
ISTART  = 0
ICHARG  = 2
GGA     = PE
IVDW = 12

PREC    = Accurate
ENCUT   = 410
EDIFF   = 1E-7
LREAL   = .FALSE.
ADDGRID = .TRUE.
LASPH   = .TRUE.
ALGO    = Normal
NELM    = 200
NELMIN  = 6
ISMEAR  = 0
SIGMA   = 0.05

IBRION  = -1
NSW     = 0
ISYM    = 0
# the dipole correction is inherited by gen from the S1 INCAR (a comment line when LDIPOL is off)
# dipole correction: not enabled (LDIPOL) in step1_std_opt, kept consistent here

LWAVE   = .FALSE.
LCHARG  = .FALSE.
LORBIT  = 0
NCORE   = 4
KPAR    = 2

# ---- Spin / DFT+U: inherited from S1 step1_std_opt ([0163], same potential-energy surface as the relaxation) ----
ISPIN    = 2
MAGMOM   = 32*5 192*0
LMAXMIX  = 4
LDAU     = .TRUE.
LDAUTYPE = 2
LDAUL    = 2 -1 -1
LDAUU    = 4 0.0 0.0
LDAUJ    = 0.0 0.0 0.0
LDAUPRINT = 1
