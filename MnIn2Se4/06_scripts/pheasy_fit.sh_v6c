#!/bin/bash
# =============================================================================
#  pheasy_fit.sh -- general-purpose force-constant fitting script (v5)
# =============================================================================
#  run it in a directory containing POSCAR / SPOSCAR / disp_matrix.pkl / force_matrix.pkl:
#      bash pheasy_fit.sh [KEY=VAL ...]
#
#  ┌──────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
#  │ Fitting methods (FIT_METHOD = -l/--model)                                                                    │
#  ├──────────────────────────────────────────────────────────────────────────────────────────────────────────────┤
#  │  OLS            ordinary least squares. dense->SVD(gelsd), sparse->LSQR, two-level->LSMR                     │
#  │                 (dispatched by memory automatically). no regularization, the baseline method.                │
#  │  LASSO          L1 regularization + cross-validated alpha, debiased by default (relaxed).                    │
#  │  ALASSO         adaptive LASSO (Zou 2006): initial ridge estimate -> adaptive weights ->                     │
#  │                 LASSO. less shrinkage bias than plain LASSO.                                                 │
#  │  RFE            recursive feature elimination: scale-invariant importance + grouped CV.                      │
#  │  RFE-OLS-TSQR   RFE + Q-less tree TSQR. use only when dense blocks do not fit in memory;                     │
#  │                 numerically equivalent to RFE under the default cv stopping rule, roughly 2x slower on small │
#  │                 systems, with limited parallel speedup (2.4x vs 9.3x).                                       │
#  │  RIDGE          L2 ridge regression (CV-selected alpha). dense path is BLAS-bound:                           │
#  │                 closed form is one gesdd per fold, so cores are best spent on BLAS;                          │
#  │                 PHEASY_RIDGE_N_JOBS only matters for the operator (LSMR) branch.                             │
#  └──────────────────────────────────────────────────────────────────────────────────────────────────────────────┘
#
#  ┌────────────────────────────────────────────────────────────────────────────────────────────┐
#  │ Parameter groups (KEY=VAL)                                                                 │
#  ├────────────────────────────────────────────────────────────────────────────────────────────┤
#  │ [structure / cutoff]                                                                       │
#  │   FIT_ORDER      order 2/3/4                       (default 3)                             │
#  │   C2_CUTOFF      2nd-order cutoff radius in A or a negative index   (default None)         │
#  │   C3_CUTOFF      3rd-order cutoff radius in A                  (default 5.2)               │
#  │   C4_CUTOFF      4th-order cutoff (required if FIT_ORDER=4)  (default None)                │
#  │   NULL_SPACE_EPS null-space construction tolerance              (default 0.001)            │
#  │ [data]                                                                                     │
#  │   NDATA          configurations to fit (empty = all)        (default empty)                │
#  │   FORCE_REBUILD  recompute from scratch, ignoring caches, if true         (default false)  │
#  │ [fit solver]                                                                               │
#  │   STANDARDIZE    column standardization LASSO/ALASSO/RIDGE    (default true)               │
#  │   LASSO_TOL      coordinate-descent tolerance (do not revert to 1e-3)     (default 1e-6)   │
#  │   LASSO_MAX_ITER maximum number of iterations                    (default 20000)           │
#  │ [regularization / CV]                                                                      │
#  │   CV             number of CV folds (grouped by config)            (default 5)             │
#  │   NMU            number of alpha/ridge grid points           (default 20)                  │
#  │                  (also sets the ALASSO default density (nmu-1)/4/decade)                   │
#  │   ALPHA_DECADES  alpha_auto grid span in decades    (default 4.0)                          │
#  │                  (the ALASSO overdetermined branch has a max(decades,6) floor)             │
#  │   MU_MIN/MU_MAX  RIDGE manual grid 10^min..10^max  (default -6/-2)                         │
#  │ [memory / parallelism]                                                                     │
#  │   SM_DTYPE       sensing matrix precision float32/64 (default float32)                     │
#  │   NCPU           total cores (BLAS threads + outer parallelism cap of each method)         │
#  │   NJOBS          outer parallelism (folds/alpha); empty = automatic                        │
#  │   LASSO_SPARSE   PHEASY_LASSO_SPARSE=1 uses a sparse SM (default 0=dense)                  │
#  │   LASSO_TWOLEVEL PHEASY_LASSO_TWOLEVEL=1 two-level matvec (not even the sparse product     │
#  │                  is materialized; only worth it when the sparse product also does not fit) │
#  └────────────────────────────────────────────────────────────────────────────────────────────┘
#
#  other common environment variables:
#    PHEASY_LASSO_DEBIAS=0   turn off LASSO/ALASSO debiasing
#    PHEASY_RFE_STEP=0.05    fraction of features RFE deletes per round
#    PHEASY_RFE_MIN_FEATURES minimum number of features RFE keeps
#    PHEASY_OLS_TWOLEVEL=0   turn off the OLS two-level matvec
#    PHEASY_LASSO_1SE=1      use the 1-SE rule in the LASSO CV
#    PHEASY_TSQR_CRITERION=  TSQR stopping rule: cv|bic|aic (default cv)
#    PHEASY_BIC_N_EFF=      effective observations for BIC/AIC: groups|samples (default groups=config count)
#    PHEASY_ALASSO_WEIGHTED_GRID= ALASSO weighted alpha grid (default 1).
#                           1=weighted KKT threshold grid (recommended, P37/P38/P40):
#                           in the overdetermined case it descends to the unweighted threshold scale, with the density per decade
#                           fixed (PHEASY_ALPHA_PER_DECADE); 0=fall back to the mu_shift
#                           empirical grid (usable for history, not recommended). note: the ALASSO penalty
#                           lives in the weighted space, so a manual grid
#                           (--no-alpha_auto --mu_min/--mu_max) is a known degradation
#                           path -- an unweighted-scale grid over-regularizes badly, e.g.
#                           MnIn2Se4 c3=5.2 n45 [1e-6,1e-2]: re 0.0063->0.077,
#                           nnz 1223->375 (since P38 a manual grid is respected as given)
#    PHEASY_ALPHA_PER_DECADE ALASSO weighted grid points per decade (default (nmu-1)/4)
#    PHEASY_ALPHA_NMAX=       hard cap on the ALASSO weighted grid point count (default 200)
#    PHEASY_ALASSO_GRID_DIAG= scale-mismatch diagnostic rmatvec for a manual grid (default 1, only
#                              on the --no-alpha_auto path)
#
#  examples:
#    bash pheasy_fit.sh FIT_METHOD=OLS    C3_CUTOFF=5.2
#    bash pheasy_fit.sh FIT_METHOD=LASSO  C3_CUTOFF=7.0 NDATA=45 NCPU=8
#    bash pheasy_fit.sh FIT_METHOD=ALASSO C3_CUTOFF=5.2
#    bash pheasy_fit.sh FIT_METHOD=RFE    C3_CUTOFF=5.2
#    bash pheasy_fit.sh FIT_METHOD=RIDGE  C3_CUTOFF=5.2 MU_MIN=-6 MU_MAX=-2
# =============================================================================
set -uo pipefail

# This distribution installs pheasy-gpu; a co-installed upstream pheasy
# command would silently run a different package.  (v6c: restored the pre-v4 logic,
# v4-v6b had this hard-coded to pheasy, so the pheasy-gpu fixes never took effect.)
PHEASY_EXECUTABLE="${PHEASY_EXECUTABLE:-pheasy-gpu}"
if ! command -v "$PHEASY_EXECUTABLE" >/dev/null 2>&1; then
  echo "cannot find $PHEASY_EXECUTABLE; install pheasy-gpu or point PHEASY_EXECUTABLE at the program path." >&2
  exit 2
fi

# ===== default parameters (overridable with KEY=VAL on the command line) =====
FIT_METHOD="OLS"
FIT_ORDER=3
C2_CUTOFF=None
C3_CUTOFF=5.2
C4_CUTOFF=None
NULL_SPACE_EPS=0.001
NDATA=""                # number of configurations to fit (empty = all)
FORCE_REBUILD=false
STANDARDIZE=true
LASSO_TOL=1e-6
LASSO_MAX_ITER=20000
CV=5
NMU=20
ALPHA_DECADES=4.0
ALPHA_AUTO=true         # false = use a manual --no-alpha_auto --mu_min/--mu_max grid (forces sparse)
MU_MIN=-6
MU_MAX=-2
SM_DTYPE=float32
NCPU="${SLURM_CPUS_PER_TASK:-8}"
NJOBS=""                # outer parallelism (folds/alpha); empty = automatic (all cores)
LASSO_SPARSE=0          # PHEASY_LASSO_SPARSE
LASSO_TWOLEVEL=0        # PHEASY_LASSO_TWOLEVEL
RASR=None               # rotational acoustic sum rule: BH/H/BHH/None
                        # note: enabling it reduces the number of free parameters p (the null-space dimension shrinks), so results are not comparable with the historical RASR=None runs
                        # for 2D materials (with a ZA flexural branch) BHH is strongly recommended -- rotational invariance guarantees the ZA w ~ q^2; without the RSR small imaginary frequencies appear near Gamma
DO_RASR=FIT             # how RASR is applied: FIT=folded into the null space / PP=projected afterwards

# ----- data/structure consistency guard (added in v4) -----
ALIGN_DATA=true         # after step[1/4], permute the disp/force matrices from the SPOSCAR.ref order into the SPOSCAR order written by pheasy.
                        # pheasy rewrites SPOSCAR with its own enumeration; for some systems/supercells that order can differ from the input
                        # (measured on Mn2In2Se5 3x3x1: 9/81 Se atoms differ). without alignment the force residual degrades from 0.9% to 10%,
                        # and completely silently. this switch is the guard for that problem and must default to true.
REL_ERR_WARN=0.05       # warning threshold on the post-fit relative force residual (0 or empty = off)
SPOSCAR_REF=""          # optional: explicitly give the path of "the SPOSCAR the data is based on" (used when reviving an old directory)
ALIGN_OUTPUT=true       # (added in v5) after the fit, permute the fc2/fc3/fc4 pheasy wrote from the pheasy atom order
                        # back to the SPOSCAR.ref (data/downstream) order. pheasy's SPOSCAR rewrite can happen for every
                        # system; without the back-fill the downstream phono3py/ShengBTE get force constants in the wrong order,
                        # and kappa silently deviates by 30% while the residual/RMSE look perfectly normal. idempotent, must default to true.

# ----- sparse-method guard (added in v6) -----
FIX_FC2=false           # true = keep the 2nd order fixed/dense and let the sparse model touch only the 3rd order (--fix_fc2).
                        # the 2nd order alone determines the harmonic dynamical matrix; cutting too hard gives imaginary frequencies even though the ASR is satisfied.
FIX_FC2_AUTO=true       # when true the 2nd order is fitted densely on the harmonic block with LSQR (PHEASY_FIX_FC2_AUTO=1),
                        # without reading an external FC2 file; when false it reads FORCE_CONSTANTS/fc.hdf5/Phi2.npz
HARM_DENSE=false        # true = set the L1 penalty weight of HARM/FC2 to 0 in the joint fit (PHEASY_HARM_DENSE=1),
                        # sparsifying ANHARM3 only; more correct than FIX_FC2 (FC2 still takes part in the refit).

_ALLOWED="FIT_METHOD FIT_ORDER C2_CUTOFF C3_CUTOFF C4_CUTOFF NULL_SPACE_EPS \
NDATA FORCE_REBUILD STANDARDIZE LASSO_TOL LASSO_MAX_ITER CV NMU ALPHA_DECADES \
ALPHA_AUTO MU_MIN MU_MAX SM_DTYPE NCPU NJOBS LASSO_SPARSE LASSO_TWOLEVEL RASR DO_RASR \
ALIGN_DATA REL_ERR_WARN SPOSCAR_REF ALIGN_OUTPUT FIX_FC2 FIX_FC2_AUTO HARM_DENSE"
for kv in "$@"; do
  case "$kv" in
    *=*)
      k="${kv%%=*}"; v="${kv#*=}"
      case " $_ALLOWED " in
        *" $k "*) printf -v "$k" '%s' "$v" ;;
        *) echo "unknown parameter $k; available: $_ALLOWED" >&2; exit 2 ;;
      esac ;;
    *) echo "a parameter must be given as KEY=VAL: $kv" >&2; exit 2 ;;
  esac
done

case "$FIT_METHOD" in
  OLS|LASSO|ALASSO|RFE|RFE-OLS-TSQR|RIDGE) ;;
  *) echo "FIT_METHOD=$FIT_METHOD is not a valid method; choose from: OLS LASSO ALASSO RFE RFE-OLS-TSQR RIDGE" >&2; exit 2 ;;
esac
case "$RASR" in
  None|none|BH|H|BHH) ;;
  *) echo "RASR=$RASR is invalid; choose from: None BH H BHH" >&2; exit 2 ;;
esac
if [ "$FIT_ORDER" -ge 4 ] && { [ "$C4_CUTOFF" = "None" ] || [ "$C4_CUTOFF" = "none" ]; }; then
  echo "FIT_ORDER=4 but C4_CUTOFF is not set; an uncutoff fourth order makes the orbital count explode." >&2
  echo "give an explicit value, e.g. C4_CUTOFF=4.0" >&2
  exit 2
fi

for f in POSCAR SPOSCAR disp_matrix.pkl force_matrix.pkl; do
  [ -f "$f" ] || { echo "missing $f. disp_matrix.pkl / force_matrix.pkl are produced by tools/prepare_dataset.py." >&2; exit 2; }
done

export OPENBLAS_NUM_THREADS="$NCPU" OMP_NUM_THREADS="$NCPU" MKL_NUM_THREADS="$NCPU"
# PHEASY_MAX_CORES is the single authoritative source for "cores available to this job"; if it is not exported the code takes
# the parallelism and memory budget from os.cpu_count() (the node's physical core count, usually 192 under Slurm).
export PHEASY_MAX_CORES="$NCPU"
# outer (folds/alpha) parallelism; when empty, the total core count is still passed to the sensing-matrix build in run_pheasy (which uses
# PHEASY_N_JOBS for process parallelism), and the fitting methods allocate "all cores / folds" automatically.
export PHEASY_N_JOBS="${NJOBS:-$NCPU}"
export PHEASY_SM_DTYPE="$SM_DTYPE"
if [ "$LASSO_SPARSE" = "1" ] || [ "$LASSO_SPARSE" = "true" ]; then
  export PHEASY_LASSO_SPARSE=1
fi
if [ "$LASSO_TWOLEVEL" = "1" ] || [ "$LASSO_TWOLEVEL" = "true" ]; then
  export PHEASY_LASSO_TWOLEVEL=1
fi

_STRUCT_FILES="cs.pkl neighbor_list.pkl ns_harm.npz ns_anharm3.npz ns_anharm4.npz"
_DATA_FILES="sm_prime.npz fm1d.npz sm_dense.npy sm_dense.npy.meta.json"

if [ "$FORCE_REBUILD" = "true" ]; then
  rm -f dim_detected.txt $_STRUCT_FILES $_DATA_FILES \
        .pheasy_stamp_struct .pheasy_stamp_data .pheasy_stamp
fi

if [ ! -f dim_detected.txt ]; then
  python3 - <<'PY' || exit 1
import numpy as np
from phonopy.interface.vasp import read_vasp
uc = read_vasp('POSCAR'); sc = read_vasp('SPOSCAR')
R = sc.cell @ np.linalg.inv(uc.cell)
M = np.round(R).astype(int)
if not np.allclose(R, M, atol=1e-4):
    raise SystemExit("the SPOSCAR lattice is not an integer multiple of the POSCAR lattice")
if not np.allclose(M, np.diag(np.diag(M))):
    raise SystemExit("the generation matrix is not diagonal; pheasy --dim only accepts diagonal cells")
dim = np.diag(M)
open('dim_detected.txt', 'w').write(' '.join(map(str, dim)))
print("DIM =", ' '.join(map(str, dim)))
PY
fi
DIM=$(cat dim_detected.txt)

# available configurations = the number of frames in disp_matrix.pkl (the sensing matrix is built fully for this)
SM_NDATA=$(python3 -c "
import pickle
print(pickle.load(open('disp_matrix.pkl','rb')).shape[0])") || exit 1
[ -z "$NDATA" ] && NDATA="$SM_NDATA"
if [ "$NDATA" -gt "$SM_NDATA" ]; then
  echo "NDATA=$NDATA exceeds the $SM_NDATA configurations in disp_matrix.pkl." >&2; exit 2
fi

# [FIX P31] the CV fold count cannot exceed the number of configurations (GroupKFold groups by configuration, so with NDATA=2/3/4, 5 folds
# would leave only 0-1 configurations for validation per fold). the program clamps internally too; this clamps earlier and says so.
if [ "$CV" -gt "$NDATA" ]; then
  CV=$(( NDATA < 2 ? 2 : NDATA ))
  echo "CV fold count exceeds the number of configurations; clamped to $CV (NDATA=$NDATA)"
fi

C_FLAG=""
[ "$C2_CUTOFF" != "None" ] && [ "$C2_CUTOFF" != "none" ] && C_FLAG="$C_FLAG --c2 $C2_CUTOFF"
[ "$FIT_ORDER" -ge 3 ] && [ "$C3_CUTOFF" != "None" ] && [ "$C3_CUTOFF" != "none" ] && C_FLAG="$C_FLAG --c3 $C3_CUTOFF"
[ "$FIT_ORDER" -ge 4 ] && [ "$C4_CUTOFF" != "None" ] && [ "$C4_CUTOFF" != "none" ] && C_FLAG="$C_FLAG --c4 $C4_CUTOFF"
W_FLAG="-w $FIT_ORDER"
RASR_FLAGS=""
if [ "$RASR" != "None" ] && [ "$RASR" != "none" ] && [ -n "$RASR" ]; then
  RASR_FLAGS="--rasr $RASR --do_rasr $DO_RASR"
fi

# every pheasy run rewrites SPOSCAR (same content, refreshed mtime), so the structure fingerprint must
# use a content hash rather than mtime, otherwise every run decides "the structure changed" and rebuilds the cluster space.
_fp_hash() {
  if   command -v md5sum  >/dev/null 2>&1; then md5sum  "$1" | cut -d' ' -f1
  elif command -v sha1sum >/dev/null 2>&1; then sha1sum "$1" | cut -d' ' -f1
  else cksum "$1" | cut -d' ' -f1,2 | tr ' ' '_'; fi
}

# ---------------- data-order reference: SPOSCAR.ref --------------------------------------
# pheasy rewrites SPOSCAR with its own enumeration in step[1/4]. If the rewritten atom order differs from the input while
# the disp/force matrices are still arranged in input order, some atoms get **silently mislabelled** (force residual 0.9% -> 10%).
# so "the SPOSCAR the data is based on" must be pinned down first, and only then can step[1.5/4] really align.
_SPOSCAR_REF_NEW=false
if [ -n "${SPOSCAR_REF}" ]; then
  cp -f "$SPOSCAR_REF" SPOSCAR.ref &&
  _SPOSCAR_REF_NEW=true &&
  echo "[align] using SPOSCAR_REF=$SPOSCAR_REF as the data-order reference -> SPOSCAR.ref"
elif [ -f SPOSCAR ] && [ ! -f SPOSCAR.ref ]; then
  cp -f SPOSCAR SPOSCAR.ref
  _SPOSCAR_REF_NEW=true
  echo "[align] recorded the atomic order the data is based on -> SPOSCAR.ref"
fi
if [ ! -f SPOSCAR.ref ]; then
  echo "[align] ERROR: neither SPOSCAR.ref nor SPOSCAR exists, cannot do the order alignment" >&2
  exit 2
fi
if [ "$_SPOSCAR_REF_NEW" = "true" ] && { [ -f cs.pkl ] || [ -f ns_harm.npz ]; }; then
  echo "[align] note: pheasy has already run in this directory and SPOSCAR.ref was only just created;" >&2
  echo "[align]       if the previous SPOSCAR was already rewritten by pheasy the reference is wrong -- use" >&2
  echo "[align]       SPOSCAR_REF=<path to the original SPOSCAR> or rerun in a fresh directory." >&2
fi

# ---------------- level-1 fingerprint: structure / cutoff (guards the cluster space and sensing matrix) ------
# must use SPOSCAR.ref: every pheasy run rewrites SPOSCAR, so using SPOSCAR would make the fingerprint jitter constantly.
_stamp_struct=$(printf 'dim=%s order=%s c2=%s c3=%s c4=%s eps=%s poscar=%s sposcar=%s' \
  "$DIM" "$FIT_ORDER" "$C2_CUTOFF" "$C3_CUTOFF" "$C4_CUTOFF" "$NULL_SPACE_EPS" \
  "$(_fp_hash POSCAR)" "$(_fp_hash SPOSCAR.ref)")
# the code version also goes into the level-1 fingerprint: changes to the null-space/cluster-space construction code (symmetry_constraints.py,
# cluster_orbit.py) change the contents of ns_*.npz and cs.pkl, while an old directory
# silently reuses the old null space when .pheasy_stamp_struct is unchanged -- exactly the kind of change this guards against.
# _SCRIPT_DIR is the directory the script lives in (pheasy_fit.sh sits next to core/ at the repo root).
_CODE_FP=""
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
for _f in core/symmetry_constraints.py core/cluster_orbit.py; do
  if [ -f "$_SCRIPT_DIR/$_f" ]; then
    _CODE_FP="$_CODE_FP $(_fp_hash "$_SCRIPT_DIR/$_f")"
  fi
done
if [ -n "$_CODE_FP" ]; then
  _stamp_struct="${_stamp_struct} | code:${_CODE_FP}"
else
  echo "[stamp] WARNING: core/*.py not found ($_SCRIPT_DIR), fingerprint excludes the code version -- if you changed the null-space code, run FORCE_REBUILD by hand" >&2
fi
if [ -f .pheasy_stamp_struct ] && [ "$(cat .pheasy_stamp_struct)" != "$_stamp_struct" ]; then
  echo "structure/cutoff parameters changed; discarding the cluster space, null space and sensing matrix:"
  rm -f $_STRUCT_FILES $_DATA_FILES .pheasy_stamp_data .pheasy_stamp_ns
fi

# ---------------- level-1.5 fingerprint: + RASR (guards the null space only) ---------------------------
# RASR only enters the null-space construction and does not touch the cluster space or the sensing matrix (sm_prime is the product of the displacements and
# the cluster space, and NS is only multiplied on afterwards). flipping --rasr rebuilds ns_*.npz only.
_stamp_ns=$(printf '%s | rasr=%s/%s' "$_stamp_struct" "$RASR" "$DO_RASR")
if [ -f .pheasy_stamp_ns ] && [ "$(cat .pheasy_stamp_ns)" != "$_stamp_ns" ]; then
  echo "RASR parameters changed; discarding the null space only (keeping the cluster space and sensing matrix):"
  rm -f ns_harm.npz ns_anharm3.npz ns_anharm4.npz
fi

echo "fit: $FIT_METHOD | order $FIT_ORDER | c2=$C2_CUTOFF c3=$C3_CUTOFF c4=$C4_CUTOFF | DIM=$DIM | ndata=$NDATA/$SM_NDATA | dtype=$SM_DTYPE"

if [ ! -f cs.pkl ]; then
  echo "[1/4] cluster space"
  "$PHEASY_EXECUTABLE" --dim $DIM $W_FLAG -s $C_FLAG --eps $NULL_SPACE_EPS || exit 1
else
  echo "[1/4] cluster space skipped (cs.pkl)"
fi

if [ ! -f ns_harm.npz ]; then
  echo "[2/4] null space"
  "$PHEASY_EXECUTABLE" --dim $DIM $W_FLAG -c $C_FLAG --eps $NULL_SPACE_EPS $RASR_FLAGS || exit 1
else
  echo "[2/4] null space skipped (ns_harm.npz)"
fi
printf '%s' "$_stamp_struct" > .pheasy_stamp_struct
printf '%s' "$_stamp_ns" > .pheasy_stamp_ns

# ---------------- [1.5/4] data order alignment (added in v4) ---------------------------------
# pheasy has already rewritten SPOSCAR with its own enumeration in step[1/4]; here the disp/force matrices are given
# the same permutation via the "SPOSCAR.ref -> SPOSCAR" atom mapping, so the data matches the internal atom numbering of pheasy.
if [ "$ALIGN_DATA" = "true" ]; then
  echo "[1.5/4] data order alignment (SPOSCAR.ref -> pheasy SPOSCAR)"
  python3 - <<'PYALIGN' || exit 1
import hashlib, json, os, pickle
import numpy as np
from phonopy.interface.vasp import read_vasp

def md5(p):
    with open(p, "rb") as fh:
        return hashlib.md5(fh.read()).hexdigest()

ref = read_vasp("SPOSCAR.ref")
cur = read_vasp("SPOSCAR")
if len(ref) != len(cur):
    raise SystemExit("[align] different atom counts: SPOSCAR.ref=%d, SPOSCAR=%d" % (len(ref), len(cur)))
if not np.allclose(ref.cell, cur.cell, atol=1e-5):
    raise SystemExit("[align] the lattices differ, these are not the same supercell")
fr = ref.scaled_positions % 1.0
cr = cur.scaled_positions % 1.0
dd = cr[:, None, :] - fr[None, :, :]
dd -= np.round(dd)
dist = np.linalg.norm(dd @ cur.cell, axis=2)
sigma = dist.argmin(axis=1)
hit = dist[np.arange(len(sigma)), sigma]
if hit.max() > 1e-3:
    raise SystemExit("[align] coordinate matching failed, max deviation %.3e A" % hit.max())
if len(set(sigma.tolist())) != len(sigma):
    raise SystemExit("[align] the coordinate matching is not a bijection, SPOSCAR.ref and SPOSCAR are not the same structure")
if not np.array_equal(np.asarray(ref.numbers), np.asarray(cur.numbers)[sigma]):
    raise SystemExit("[align] the species differ after matching")
n = int((sigma != np.arange(len(sigma))).sum())

FILES = [f for f in ("disp_matrix.pkl", "force_matrix.pkl") if os.path.isfile(f)]
now = {f: md5(f) for f in FILES}
old = {}
if os.path.isfile(".pheasy_align.json"):
    try:
        old = json.load(open(".pheasy_align.json"))
    except Exception:
        old = {}
if FILES and old.get("post") == now:
    print("[align] the data already matches the current SPOSCAR (%d/%d atoms would move), skipping" % (n, len(sigma)))
else:
    for f in FILES:
        a = pickle.load(open(f, "rb"))
        if a.ndim != 3 or a.shape[1] != len(sigma):
            raise SystemExit("[align] %s shape %s does not match the supercell atom count %d" % (f, a.shape, len(sigma)))
        pickle.dump(np.ascontiguousarray(a[:, sigma], dtype=np.float64), open(f, "wb"))
    if n:
        print("[align] order differs for %d/%d atoms -> applied the same permutation to the disp/force matrices" % (n, len(sigma)))
        print("[align] affected atom indices: %s" % np.nonzero(sigma != np.arange(len(sigma)))[0].tolist())
    else:
        print("[align] SPOSCAR.ref and pheasy SPOSCAR orders are fully consistent, no reordering needed")
    json.dump({"n_moved": n, "sigma": sigma.tolist(), "pre": now,
               "post": {f: md5(f) for f in FILES},
               "sposcar_ref_md5": md5("SPOSCAR.ref"), "sposcar_md5": md5("SPOSCAR")},
              open(".pheasy_align.json", "w"), indent=2)
PYALIGN
fi

# ---------------- level-2 fingerprint: data (guards the sensing matrix) ---------------------------
# must be computed **after** the order alignment: otherwise it records the pre-permutation hashes and the next run wrongly decides "the data changed",
# and discards the sensing matrix and recomputes it every time.
_stamp_data=$(printf '%s | dtype=%s sm_ndata=%s disp=%s,%s force=%s,%s' \
  "$_stamp_struct" "$SM_DTYPE" "$SM_NDATA" \
  "$(stat -Lc %s disp_matrix.pkl)"  "$(_fp_hash disp_matrix.pkl)" \
  "$(stat -Lc %s force_matrix.pkl)" "$(_fp_hash force_matrix.pkl)")
if [ -f .pheasy_stamp_data ] && [ "$(cat .pheasy_stamp_data)" != "$_stamp_data" ]; then
  echo "displacement/force data or precision changed; discarding the sensing matrix:"
  rm -f $_DATA_FILES
fi

if [ ! -f sm_prime.npz ]; then
  echo "[3/4] sensing matrix (built from all $SM_NDATA configurations, reusable for any NDATA<=$SM_NDATA)"
  "$PHEASY_EXECUTABLE" --dim $DIM $W_FLAG -d $C_FLAG --ndata $SM_NDATA --disp_file --eps $NULL_SPACE_EPS || exit 1
else
  echo "[3/4] sensing matrix skipped (sm_prime.npz, built from $SM_NDATA configurations)"
fi
printf '%s' "$_stamp_data" > .pheasy_stamp_data

echo "[4/4] fit ($FIT_METHOD, ndata=$NDATA)"
FIT_FLAGS="--full_ifc -l $FIT_METHOD --hdf5 $RASR_FLAGS"
if [ "$FIX_FC2" = "true" ]; then
  # keep the 2nd order dense and sparsify only the 3rd order, so FC2 is not cut into dynamical instability (imaginary frequencies).
  FIT_FLAGS="$FIT_FLAGS --fix_fc2"
  if [ "$FIX_FC2_AUTO" = "true" ]; then
    export PHEASY_FIX_FC2_AUTO=1
  fi
fi
if [ "$HARM_DENSE" = "true" ]; then
  # joint fit, but with the L1 penalty weight of HARM/FC2 set to 0 -> FC2 stays dense and still takes part in the refit.
  export PHEASY_HARM_DENSE=1
fi
# --std applies to LASSO / ALASSO / RIDGE. RIDGE needs it most: column norms can span 1e2,
# and not standardizing means L2 penalties that differ a hundredfold between terms.
if [ "$STANDARDIZE" = "true" ] && [[ "$FIT_METHOD" =~ ^(LASSO|ALASSO|RIDGE)$ ]]; then
  FIT_FLAGS="$FIT_FLAGS --std"
fi
if [[ "$FIT_METHOD" =~ ^(LASSO|ALASSO)$ ]]; then
  # --tol 0.001 is not "tight enough": sklearn scales tol by ||y||^2, so at the small-alpha end coordinate descent
  # stops far from convergence, the CV curve flattens at that end, and argmin picks the most strongly regularized of the tied values.
  if [ "$ALPHA_AUTO" = "false" ]; then
    FIT_FLAGS="$FIT_FLAGS --no-alpha_auto --mu_min $MU_MIN --mu_max $MU_MAX --nmu $NMU --max_iter $LASSO_MAX_ITER --cv $CV --tol $LASSO_TOL"
  else
    FIT_FLAGS="$FIT_FLAGS --alpha_auto --alpha_decades $ALPHA_DECADES --max_iter $LASSO_MAX_ITER --cv $CV --nmu $NMU --tol $LASSO_TOL"
  fi
elif [ "$FIT_METHOD" = "RIDGE" ]; then
  FIT_FLAGS="$FIT_FLAGS --mu_min $MU_MIN --mu_max $MU_MAX --nmu $NMU"
fi
# force-residual guard: warn loudly when the Relative error printed after the fit exceeds REL_ERR_WARN.
# mislabelled data/structure order (~0.10), too tight a C2 cutoff (~0.05), or bad data itself will all show up here.
"$PHEASY_EXECUTABLE" --dim $DIM $W_FLAG -f $C_FLAG --ndata $NDATA --eps $NULL_SPACE_EPS $FIT_FLAGS 2>&1 \
| awk -v t="${REL_ERR_WARN:-0}" '
    { print }
    /Relative error:/ {
      v = $NF + 0
      if (t + 0 > 0 && v > t + 0) {
        printf "\n[!!! WARNING] relative force residual %.4f exceeds the threshold %.4f\n", v, t
        printf "[!!! WARNING] rule of thumb: mislabelled data order ~0.10 / fc2 cutoff too tight ~0.05 / normal is < 0.02\n"
        printf "[!!! WARNING] check that SPOSCAR.ref and the SPOSCAR pheasy wrote agree (this script aligns them automatically),\n"
        printf "[!!! WARNING] and whether C2_CUTOFF is too small.\n\n"
      }
    }' || exit 1

echo "done"
python3 -c "
import h5py, numpy as np
for fn, keys in (('fc2.hdf5', ('fc2', 'force_constants')),
                 ('fc3.hdf5', ('fc3', 'force_constants_third')),
                 ('fc4.hdf5', ('fc4', 'force_constants_fourth'))):
    try:
        with h5py.File(fn, 'r') as f:
            k = next(k for k in keys if k in f)
            print('%-9s max = %.4f' % (k, float(np.max(np.abs(np.asarray(f[k]))))))
    except (OSError, StopIteration):
        pass
" || exit 1

# =============================================================================
# [4.5/4] back-fill the output force-constant ordering (v5): pheasy order -> SPOSCAR.ref (data/downstream) order
# =============================================================================
# pheasy rebuilds the supercell with its own enumeration and rewrites SPOSCAR; the fc2/fc3/fc4 written by --full_ifc are also in
# its own atom order, while the data and the downstream tools (phono3py / hiphive / ShengBTE / kappa) go by
# the SPOSCAR.ref order. aligning the input but not the output = misequenced force constants: the force residual/RMSE look perfectly normal,
# but kappa silently deviates by tens of percent (measured on Mn2In2Se5 3x3x1: kappa_xx 1.503 vs 1.147).
# here every atom axis is permuted back using the sigma from .pheasy_align.json; the result is recorded in
# .pheasy_fc_permuted.json, so a rerun with the fit skipped by the fingerprint does not permute twice (idempotent).
if [ "${ALIGN_OUTPUT:-true}" = "true" ] && [ -f .pheasy_align.json ]; then
  echo "[4.5/4] back-fill the output force-constant ordering (pheasy order -> SPOSCAR.ref order)"
  python3 - <<'PYPERM' || exit 1
import json, os, sys, hashlib
import numpy as np
try:
    import h5py
except ImportError:
    print("[perm] no h5py, skipping"); sys.exit(0)

rec = json.load(open(".pheasy_align.json", encoding="utf-8"))
sig = np.asarray(rec.get("sigma", []), dtype=int)
if sig.size == 0:
    print("[perm] .pheasy_align.json has no sigma, skipping"); sys.exit(0)
ns = int(sig.size)
sinv = np.argsort(sig)
sig_md5 = hashlib.md5(sig.astype("<i8").tobytes()).hexdigest()[:12]
n_moved = int((sig != np.arange(ns)).sum())
if n_moved == 0:
    print("[perm] data already matches the pheasy ordering (n_moved=0), no back-fill needed"); sys.exit(0)

FLAG = ".pheasy_fc_permuted.json"
state = {}
if os.path.exists(FLAG):
    try:
        state = json.load(open(FLAG, encoding="utf-8"))
    except Exception:
        state = {}

KEYS = {"fc2.hdf5": ("fc2", "force_constants"),
        "fc3.hdf5": ("fc3", "force_constants_third"),
        "fc4.hdf5": ("fc4", "force_constants_fourth")}

def _md5(fn):
    h = hashlib.md5()
    with h5py.File(fn, "r") as fh:
        for k in sorted(fh.keys()):
            if k == "version":
                continue
            h.update(np.ascontiguousarray(fh[k][()]).tobytes())
    return h.hexdigest()[:12]

new_state = {"sigma_md5": sig_md5, "n_moved": n_moved, "files": {}}
for fn, keys in KEYS.items():
    if not os.path.exists(fn):
        continue
    cur = _md5(fn)
    old = (state.get("files") or {}).get(fn) or {}
    if old.get("post_md5") == cur and state.get("sigma_md5") == sig_md5:
        print("[perm] %s already back-filled (post_md5 %s), skipping" % (fn, cur))
        new_state["files"][fn] = old
        continue
    with h5py.File(fn, "r+") as fh:
        key = next(k for k in keys if k in fh)
        arr = np.asarray(fh[key])
        if arr.ndim == 0:
            new_state["files"][fn] = old
            continue
        if arr.shape[0] == ns:
            nax = arr.ndim // 2
            out = np.take(arr, sinv, axis=0)
            for ax in range(1, nax):
                out = np.take(out, sinv, axis=ax)
            fh[key][...] = out
        elif "p2s_map" in fh and arr.ndim in (4, 6, 8):
            p2s = np.asarray(fh["p2s_map"])
            nax = arr.ndim // 2
            full = np.zeros((ns,) + arr.shape[1:], dtype=arr.dtype)
            for a in range(arr.shape[0]):
                full[int(p2s[a])] = arr[a]
            out = np.take(full, sinv, axis=0)
            for ax in range(1, nax):
                out = np.take(out, sinv, axis=ax)
            del fh[key]
            fh.create_dataset(key, data=np.ascontiguousarray(out), compression="gzip")
            print("[perm] %s was compact, rewritten as full" % fn)
        else:
            print("[perm][WARN] cannot identify the atom axis of %s shape %s, skipping" % (fn, arr.shape))
            new_state["files"][fn] = old
            continue
    new_state["files"][fn] = {"pre_md5": cur, "post_md5": _md5(fn)}
    print("[perm] %s back-filled: %d/%d atoms moved -> SPOSCAR.ref order" % (fn, n_moved, ns))

json.dump(new_state, open(FLAG, "w", encoding="utf-8"), indent=2, sort_keys=True)
print("[perm] record written to %s" % FLAG)
PYPERM
else
  echo "[4.5/4] skipping the output order back-fill (ALIGN_OUTPUT=${ALIGN_OUTPUT:-true}, align.json=$([ -f .pheasy_align.json ] && echo yes || echo no))"
fi
