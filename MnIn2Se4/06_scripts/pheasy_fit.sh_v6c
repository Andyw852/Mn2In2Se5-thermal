#!/bin/bash
# =============================================================================
#  pheasy_fit.sh —— 通用力常数拟合脚本 (v5)
# =============================================================================
#  在含 POSCAR / SPOSCAR / disp_matrix.pkl / force_matrix.pkl 的目录里运行：
#      bash pheasy_fit.sh [KEY=VAL ...]
#
#  ┌─────────────────────────────────────────────────────────────────────┐
#  │ 拟合方法 (FIT_METHOD = -l/--model)                                   │
#  ├─────────────────────────────────────────────────────────────────────┤
#  │  OLS            普通最小二乘。稠密→SVD(gelsd)，稀疏→LSQR，两级→LSMR │
#  │                 (按内存自动分发)。无正则化，基准方法。              │
#  │  LASSO          L1 正则 + 交叉验证选 alpha，默认去偏 (relaxed)。    │
#  │  ALASSO         自适应 LASSO (Zou 2006)：初始岭估计 → 自适应权重 →  │
#  │                 LASSO。比 LASSO 更少收缩偏差。                     │
#  │  RFE            递归特征消除：scale-invariant 重要性 + 分组 CV。    │
#  │  RFE-OLS-TSQR   RFE + Q-less tree TSQR。仅当稠密块放不下内存时才用;│
#  │                 默认 cv 判停下与 RFE 数值等价, 小体系上慢约 2× 且    │
#  │                 并行加速受限 (2.4× vs 9.3×)。                      │
#  │  RIDGE          L2 岭回归 (CV 选 alpha)。稠密路径是 BLAS-bound:      │
#  │                 闭式解每折只一次 gesdd, 核给 BLAS 最划算;             │
#  │                 PHEASY_RIDGE_N_JOBS 只对算子(LSMR)分支有意义。       │
#  └─────────────────────────────────────────────────────────────────────┘
#
#  ┌─────────────────────────────────────────────────────────────────────┐
#  │ 参数分类 (KEY=VAL)                                                   │
#  ├─────────────────────────────────────────────────────────────────────┤
#  │ 【结构 / 截断】                                                      │
#  │   FIT_ORDER      阶次 2/3/4                       (默认 3)          │
#  │   C2_CUTOFF      二阶截断半径 Å 或负整数最近邻   (默认 None)        │
#  │   C3_CUTOFF      三阶截断半径 Å                  (默认 5.2)         │
#  │   C4_CUTOFF      四阶截断 (FIT_ORDER=4 时必填)  (默认 None)         │
#  │   NULL_SPACE_EPS 零空间构造数值容差              (默认 0.001)       │
#  │ 【数据】                                                             │
#  │   NDATA          拟合用构型数 (空 = 全部)        (默认 空)          │
#  │   FORCE_REBUILD  true 时忽略中间缓存重算         (默认 false)       │
#  │ 【拟合求解】                                                         │
#  │   STANDARDIZE    列标准化 LASSO/ALASSO/RIDGE    (默认 true)         │
#  │   LASSO_TOL      坐标下降容差 (勿回退 1e-3)     (默认 1e-6)         │
#  │   LASSO_MAX_ITER 最大迭代次数                    (默认 20000)       │
#  │ 【正则化 / CV】                                                      │
#  │   CV             CV 折数 (按构型分组)            (默认 5)           │
#  │   NMU            alpha/ridge 网格点数           (默认 20)           │
#  │                  (也决定 ALASSO 默认密度 (nmu-1)/4/decade)          │
#  │   ALPHA_DECADES  alpha_auto 网格跨度(数量级)    (默认 4.0)         │
#  │                  (ALASSO 超定分支有 max(decades,6) 下限)             │
#  │   MU_MIN/MU_MAX  RIDGE 手动网格 10^min..10^max  (默认 -6/-2)       │
#  │ 【内存 / 并行】                                                      │
#  │   SM_DTYPE       sensing matrix 精度 float32/64 (默认 float32)     │
#  │   NCPU           总核数(BLAS 线程 + 各方法外层并行上限)             │
#  │   NJOBS          外层并行度(折/alpha); 留空 = 自动                  │
#  │   LASSO_SPARSE   PHEASY_LASSO_SPARSE=1 走稀疏 SM(默认 0=稠密)      │
#  │   LASSO_TWOLEVEL PHEASY_LASSO_TWOLEVEL=1 两级matvec(连稀疏乘积都不  │
#  │                  物化，仅当稀疏乘积也放不下内存时才划算)            │
#  └─────────────────────────────────────────────────────────────────────┘
#
#  其它常用环境变量：
#    PHEASY_LASSO_DEBIAS=0   关闭 LASSO/ALASSO 去偏
#    PHEASY_RFE_STEP=0.05    RFE 每轮删除比例
#    PHEASY_RFE_MIN_FEATURES RFE 最小保留特征数
#    PHEASY_OLS_TWOLEVEL=0   关闭 OLS 两级 matvec
#    PHEASY_LASSO_1SE=1      LASSO CV 用 1-SE 规则
#    PHEASY_TSQR_CRITERION=  TSQR 判停: cv|bic|aic (默认 cv)
#    PHEASY_BIC_N_EFF=      BIC/AIC 的有效观测: groups|samples (默认 groups=构型数)
#    PHEASY_ALASSO_WEIGHTED_GRID= ALASSO 加权 alpha 网格 (默认 1)。
#                           1=加权 KKT 阈值网格 (推荐, P37/P38/P40):
#                           超定时自动下探到未加权阈值尺度, 密度每 decade
#                           固定 (PHEASY_ALPHA_PER_DECADE); 0=回退 mu_shift
#                           经验网格 (历史可用, 不推荐)。注意: ALASSO 惩罚
#                           在加权空间, 手动网格
#                           (--no-alpha_auto --mu_min/--mu_max) 是已知劣化
#                           路径 -- 未加权尺度的网格会严重过正则化, 例如
#                           MnIn2Se4 c3=5.2 n45 [1e-6,1e-2]: re 0.0063->0.077,
#                           nnz 1223->375 (P38 起手动网格会被原样尊重)
#    PHEASY_ALPHA_PER_DECADE ALASSO 加权网格每 decade 格点数 (默认 (nmu-1)/4)
#    PHEASY_ALPHA_NMAX=       ALASSO 加权网格格点数硬上限 (默认 200)
#    PHEASY_ALASSO_GRID_DIAG= 手动网格尺度假错配诊断 rmatvec (默认 1, 仅
#                              --no-alpha_auto 路径生效)
#
#  示例：
#    bash pheasy_fit.sh FIT_METHOD=OLS    C3_CUTOFF=5.2
#    bash pheasy_fit.sh FIT_METHOD=LASSO  C3_CUTOFF=7.0 NDATA=45 NCPU=8
#    bash pheasy_fit.sh FIT_METHOD=ALASSO C3_CUTOFF=5.2
#    bash pheasy_fit.sh FIT_METHOD=RFE    C3_CUTOFF=5.2
#    bash pheasy_fit.sh FIT_METHOD=RIDGE  C3_CUTOFF=5.2 MU_MIN=-6 MU_MAX=-2
# =============================================================================
set -uo pipefail

# This distribution installs pheasy-gpu; a co-installed upstream pheasy
# command would silently run a different package.  (v6c: 恢复 pre-v4 的逻辑,
# v4-v6b 曾把这里硬编码成 pheasy, 导致 pheasy-gpu 的修复根本不生效。)
PHEASY_EXECUTABLE="${PHEASY_EXECUTABLE:-pheasy-gpu}"
if ! command -v "$PHEASY_EXECUTABLE" >/dev/null 2>&1; then
  echo "找不到 $PHEASY_EXECUTABLE；请安装 pheasy-gpu 或设置 PHEASY_EXECUTABLE 为程序路径。" >&2
  exit 2
fi

# ===== 默认参数 (命令行 KEY=VAL 可覆盖) =====
FIT_METHOD="OLS"
FIT_ORDER=3
C2_CUTOFF=None
C3_CUTOFF=5.2
C4_CUTOFF=None
NULL_SPACE_EPS=0.001
NDATA=""                # 拟合构型数 (空 = 全部)
FORCE_REBUILD=false
STANDARDIZE=true
LASSO_TOL=1e-6
LASSO_MAX_ITER=20000
CV=5
NMU=20
ALPHA_DECADES=4.0
ALPHA_AUTO=true         # false = 用 --no-alpha_auto --mu_min/--mu_max 手动网格 (强制稀疏)
MU_MIN=-6
MU_MAX=-2
SM_DTYPE=float32
NCPU="${SLURM_CPUS_PER_TASK:-8}"
NJOBS=""                # 外层并行度(折/alpha); 留空 = 自动(全核)
LASSO_SPARSE=0          # PHEASY_LASSO_SPARSE
LASSO_TWOLEVEL=0        # PHEASY_LASSO_TWOLEVEL
RASR=None               # 旋转声学和规则 BH/H/BHH/None
                        # 注意: 开启会减少自由参数 p(零空间维度变小), 与 RASR=None 的历史结果不可比
                        # 2D 材料(有 ZA 弯曲支)强烈建议 BHH —— ZA 的 ω∝q² 由旋转不变性保证, 不加 RSR 时 Γ 附近会出现小虚频
DO_RASR=FIT             # RASR 施加方式 FIT=揉进零空间 / PP=事后投影

# ----- 数据/结构一致性护栏 (v4 新增) -----
ALIGN_DATA=true         # step[1/4] 后把 disp/force 矩阵从 SPOSCAR.ref 顺序重排到 pheasy 写出的 SPOSCAR 顺序。
                        # pheasy 会用自己的枚举重写 SPOSCAR, 不同体系/超胞下顺序可能与输入不同
                        # (Mn2In2Se5 3x3x1 实测 9/81 个 Se 原子不同)。不对齐会让力残差从 0.9% 恶化到 10%,
                        # 而且完全静默。这个开关就是该问题的护栏, 默认必须 true。
REL_ERR_WARN=0.05       # 拟合后力残差相对误差告警阈值 (0 或空 = 关闭)
SPOSCAR_REF=""          # 可选: 显式指定"数据所依据的 SPOSCAR"路径 (恢复旧目录时用)
ALIGN_OUTPUT=true       # (v5 新增) fit 后把 pheasy 写出的 fc2/fc3/fc4 从 pheasy 原子序
                        # 置换回 SPOSCAR.ref(数据/下游)序。pheasy 的 SPOSCAR 重写对每个
                        # 体系都可能发生; 不回填则下游 phono3py/ShengBTE 拿到错序的力常数,
                        # κ 会静默偏 30% 而残差/RMSE 完全正常。幂等, 默认必须 true。

# ----- 稀疏方法护栏 (v6 新增) -----
FIX_FC2=false           # true = 2 阶固定/稠密, 只让稀疏模型动 3 阶 (--fix_fc2)。
                        # 2 阶单独决定谐波动力学矩阵; 稀疏剪狠了会虚频, 而 ASR 是满足的。
FIX_FC2_AUTO=true       # true 时 2 阶在谐波块上用 LSQR 稠密拟合 (PHEASY_FIX_FC2_AUTO=1),
                        # 不读外部 FC2 文件; false 时读 FORCE_CONSTANTS/fc.hdf5/Phi2.npz
HARM_DENSE=false        # true = 联合拟合里把 HARM/FC2 的 L1 罚权置 0 (PHEASY_HARM_DENSE=1),
                        # 只对 ANHARM3 做稀疏; 比 FIX_FC2 更正确(FC2 仍参与重拟合)。

_ALLOWED="FIT_METHOD FIT_ORDER C2_CUTOFF C3_CUTOFF C4_CUTOFF NULL_SPACE_EPS \
NDATA FORCE_REBUILD STANDARDIZE LASSO_TOL LASSO_MAX_ITER CV NMU ALPHA_DECADES \
ALPHA_AUTO MU_MIN MU_MAX SM_DTYPE NCPU NJOBS LASSO_SPARSE LASSO_TWOLEVEL RASR DO_RASR \
ALIGN_DATA REL_ERR_WARN SPOSCAR_REF ALIGN_OUTPUT FIX_FC2 FIX_FC2_AUTO HARM_DENSE"
for kv in "$@"; do
  case "$kv" in
    *=*)
      k="${kv%%=*}"; v="${kv#*=}"
      case " $_ALLOWED " in
        *" $k "*) printf -v "$k" '%s' "$v" ;;
        *) echo "未知参数 $k；可用: $_ALLOWED" >&2; exit 2 ;;
      esac ;;
    *) echo "参数必须是 KEY=VAL 形式: $kv" >&2; exit 2 ;;
  esac
done

case "$FIT_METHOD" in
  OLS|LASSO|ALASSO|RFE|RFE-OLS-TSQR|RIDGE) ;;
  *) echo "FIT_METHOD=$FIT_METHOD 不是合法方法; 可选: OLS LASSO ALASSO RFE RFE-OLS-TSQR RIDGE" >&2; exit 2 ;;
esac
case "$RASR" in
  None|none|BH|H|BHH) ;;
  *) echo "RASR=$RASR 非法; 可选: None BH H BHH" >&2; exit 2 ;;
esac
if [ "$FIT_ORDER" -ge 4 ] && { [ "$C4_CUTOFF" = "None" ] || [ "$C4_CUTOFF" = "none" ]; }; then
  echo "FIT_ORDER=4 但没有设 C4_CUTOFF；四阶不截断会让轨道数爆炸。" >&2
  echo "请显式给一个值，例如 C4_CUTOFF=4.0" >&2
  exit 2
fi

for f in POSCAR SPOSCAR disp_matrix.pkl force_matrix.pkl; do
  [ -f "$f" ] || { echo "缺少 $f。disp_matrix.pkl / force_matrix.pkl 用 tools/prepare_dataset.py 生成。" >&2; exit 2; }
done

export OPENBLAS_NUM_THREADS="$NCPU" OMP_NUM_THREADS="$NCPU" MKL_NUM_THREADS="$NCPU"
# PHEASY_MAX_CORES 是"本作业可用核数"的唯一权威来源；不导出时代码会按
# os.cpu_count()(节点物理核数, Slurm 上通常是 192) 计算并行度和内存预算。
export PHEASY_MAX_CORES="$NCPU"
# 外层(折/alpha)并行度；留空时仍给 run_pheasy 的传感矩阵构建(它用
# PHEASY_N_JOBS 做进程并行)传总核数, 拟合方法侧按"全核/折数"自动分配。
export PHEASY_N_JOBS="${NJOBS:-$NCPU}"
export PHEASY_SM_DTYPE="$SM_DTYPE"
if [ "$LASSO_SPARSE" = "1" ] || [ "$LASSO_SPARSE" = "true" ]; then
  export PHEASY_LASSO_SPARSE=1
fi
if [ "$LASSO_TWOLEVEL" = "1" ] || [ "$LASSO_TWOLEVEL" = "true" ]; then
  export PHEASY_LASSO_TWOLEVEL=1
fi

_STRUCT_FILES="cs.pkl neighbor_list.pkl ns_harm.npz ns_anharm3.npz ns_anharm4.npz"
_DATA_FILES="sm_prime.npz fm1d.npz sm_dense.npy sm_dense.npy.meta.json"

if [ "$FORCE_REBUILD" = "true" ]; then
  rm -f dim_detected.txt $_STRUCT_FILES $_DATA_FILES \
        .pheasy_stamp_struct .pheasy_stamp_data .pheasy_stamp
fi

if [ ! -f dim_detected.txt ]; then
  python3 - <<'PY' || exit 1
import numpy as np
from phonopy.interface.vasp import read_vasp
uc = read_vasp('POSCAR'); sc = read_vasp('SPOSCAR')
R = sc.cell @ np.linalg.inv(uc.cell)
M = np.round(R).astype(int)
if not np.allclose(R, M, atol=1e-4):
    raise SystemExit("SPOSCAR 晶格不是 POSCAR 的整数倍组合")
if not np.allclose(M, np.diag(np.diag(M))):
    raise SystemExit("生成矩阵非对角；pheasy --dim 只接受对角胞")
dim = np.diag(M)
open('dim_detected.txt', 'w').write(' '.join(map(str, dim)))
print("DIM =", ' '.join(map(str, dim)))
PY
fi
DIM=$(cat dim_detected.txt)

# 可用构型数 = disp_matrix.pkl 里的帧数（sensing matrix 按这个建满）
SM_NDATA=$(python3 -c "
import pickle
print(pickle.load(open('disp_matrix.pkl','rb')).shape[0])") || exit 1
[ -z "$NDATA" ] && NDATA="$SM_NDATA"
if [ "$NDATA" -gt "$SM_NDATA" ]; then
  echo "NDATA=$NDATA 超过 disp_matrix.pkl 里的 $SM_NDATA 个构型。" >&2; exit 2
fi

# [FIX P31] CV 折数不能超过构型数（GroupKFold 按构型分组，NDATA=2/3/4 时 5 折
# 会每折只有 0-1 个构型做验证）。程序内虽也有 clamp，这里提前夹住并提示。
if [ "$CV" -gt "$NDATA" ]; then
  CV=$(( NDATA < 2 ? 2 : NDATA ))
  echo "CV 折数超过构型数，已夹到 $CV (NDATA=$NDATA)"
fi

C_FLAG=""
[ "$C2_CUTOFF" != "None" ] && [ "$C2_CUTOFF" != "none" ] && C_FLAG="$C_FLAG --c2 $C2_CUTOFF"
[ "$FIT_ORDER" -ge 3 ] && [ "$C3_CUTOFF" != "None" ] && [ "$C3_CUTOFF" != "none" ] && C_FLAG="$C_FLAG --c3 $C3_CUTOFF"
[ "$FIT_ORDER" -ge 4 ] && [ "$C4_CUTOFF" != "None" ] && [ "$C4_CUTOFF" != "none" ] && C_FLAG="$C_FLAG --c4 $C4_CUTOFF"
W_FLAG="-w $FIT_ORDER"
RASR_FLAGS=""
if [ "$RASR" != "None" ] && [ "$RASR" != "none" ] && [ -n "$RASR" ]; then
  RASR_FLAGS="--rasr $RASR --do_rasr $DO_RASR"
fi

# pheasy 每次运行都会重写 SPOSCAR（内容不变但 mtime 刷新），所以结构指纹必须
# 用内容哈希而不是 mtime，否则每跑一次都判定"结构变了"并重建 cluster space。
_fp_hash() {
  if   command -v md5sum  >/dev/null 2>&1; then md5sum  "$1" | cut -d' ' -f1
  elif command -v sha1sum >/dev/null 2>&1; then sha1sum "$1" | cut -d' ' -f1
  else cksum "$1" | cut -d' ' -f1,2 | tr ' ' '_'; fi
}

# ---------------- 数据顺序基准：SPOSCAR.ref --------------------------------------
# pheasy 在 step[1/4] 会用自己的枚举重写 SPOSCAR。若重写后的原子顺序与输入不同, 而
# disp/force 矩阵仍按输入顺序排, 就会把部分原子**静默错标** (力残差 0.9% -> 10%)。
# 所以必须先把"数据所依据的 SPOSCAR"固定下来, step[1.5/4] 才能真正对齐。
_SPOSCAR_REF_NEW=false
if [ -n "${SPOSCAR_REF}" ]; then
  cp -f "$SPOSCAR_REF" SPOSCAR.ref &&
  _SPOSCAR_REF_NEW=true &&
  echo "[align] 以 SPOSCAR_REF=$SPOSCAR_REF 作为数据顺序基准 -> SPOSCAR.ref"
elif [ -f SPOSCAR ] && [ ! -f SPOSCAR.ref ]; then
  cp -f SPOSCAR SPOSCAR.ref
  _SPOSCAR_REF_NEW=true
  echo "[align] 已记录数据所依据的原子顺序 -> SPOSCAR.ref"
fi
if [ ! -f SPOSCAR.ref ]; then
  echo "[align] 错误: 既无 SPOSCAR.ref 也无 SPOSCAR, 无法做顺序对齐" >&2
  exit 2
fi
if [ "$_SPOSCAR_REF_NEW" = "true" ] && { [ -f cs.pkl ] || [ -f ns_harm.npz ]; }; then
  echo "[align] 注意: 本目录已跑过 pheasy, 而 SPOSCAR.ref 本次才建立;" >&2
  echo "[align]       若此前的 SPOSCAR 已被 pheasy 重写, 基准就是错的 —— 请用" >&2
  echo "[align]       SPOSCAR_REF=<原始SPOSCAR路径> 或在全新目录里重跑。" >&2
fi

# ---------------- 一级指纹：结构 / cutoff（守 cluster space 与 sensing matrix）------
# 必须用 SPOSCAR.ref: pheasy 每跑一次都会重写 SPOSCAR, 用 SPOSCAR 会让指纹反复抖动。
_stamp_struct=$(printf 'dim=%s order=%s c2=%s c3=%s c4=%s eps=%s poscar=%s sposcar=%s' \
  "$DIM" "$FIT_ORDER" "$C2_CUTOFF" "$C3_CUTOFF" "$C4_CUTOFF" "$NULL_SPACE_EPS" \
  "$(_fp_hash POSCAR)" "$(_fp_hash SPOSCAR.ref)")
# 代码版本也进一级指纹：零空间/cluster-space 构造代码（symmetry_constraints.py、
# cluster_orbit.py）的改动会改变 ns_*.npz 与 cs.pkl 的内容，而旧目录在
# .pheasy_stamp_struct 未变时会静默复用旧零空间 -- 正是这类改动最该防的。
# _SCRIPT_DIR 取脚本所在目录（pheasy_fit.sh 与 core/ 同处仓库根）。
_CODE_FP=""
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
for _f in core/symmetry_constraints.py core/cluster_orbit.py; do
  if [ -f "$_SCRIPT_DIR/$_f" ]; then
    _CODE_FP="$_CODE_FP $(_fp_hash "$_SCRIPT_DIR/$_f")"
  fi
done
if [ -n "$_CODE_FP" ]; then
  _stamp_struct="${_stamp_struct} | code:${_CODE_FP}"
else
  echo "[stamp] 警告: 未找到 core/*.py ($_SCRIPT_DIR), 指纹不含代码版本 -- 改过零空间代码请手动 FORCE_REBUILD" >&2
fi
if [ -f .pheasy_stamp_struct ] && [ "$(cat .pheasy_stamp_struct)" != "$_stamp_struct" ]; then
  echo "结构/截断参数已变化，丢弃 cluster space、null space 与 sensing matrix："
  rm -f $_STRUCT_FILES $_DATA_FILES .pheasy_stamp_data .pheasy_stamp_ns
fi

# ---------------- 一级半指纹：+ RASR（只守 null space）---------------------------
# RASR 只进零空间构造，不动 cluster space 和 sensing matrix（sm_prime 是位移与
# cluster space 的产物，NS 是之后才乘上去的）。翻 --rasr 开关只重建 ns_*.npz。
_stamp_ns=$(printf '%s | rasr=%s/%s' "$_stamp_struct" "$RASR" "$DO_RASR")
if [ -f .pheasy_stamp_ns ] && [ "$(cat .pheasy_stamp_ns)" != "$_stamp_ns" ]; then
  echo "RASR 参数已变化，只丢弃 null space（保留 cluster space 与 sensing matrix）："
  rm -f ns_harm.npz ns_anharm3.npz ns_anharm4.npz
fi

echo "拟合: $FIT_METHOD | 阶次 $FIT_ORDER | c2=$C2_CUTOFF c3=$C3_CUTOFF c4=$C4_CUTOFF | DIM=$DIM | ndata=$NDATA/$SM_NDATA | dtype=$SM_DTYPE"

if [ ! -f cs.pkl ]; then
  echo "[1/4] cluster space"
  "$PHEASY_EXECUTABLE" --dim $DIM $W_FLAG -s $C_FLAG --eps $NULL_SPACE_EPS || exit 1
else
  echo "[1/4] cluster space 跳过 (cs.pkl)"
fi

if [ ! -f ns_harm.npz ]; then
  echo "[2/4] null space"
  "$PHEASY_EXECUTABLE" --dim $DIM $W_FLAG -c $C_FLAG --eps $NULL_SPACE_EPS $RASR_FLAGS || exit 1
else
  echo "[2/4] null space 跳过 (ns_harm.npz)"
fi
printf '%s' "$_stamp_struct" > .pheasy_stamp_struct
printf '%s' "$_stamp_ns" > .pheasy_stamp_ns

# ---------------- [1.5/4] 数据顺序对齐 (v4 新增) ---------------------------------
# pheasy 已在 step[1/4] 用它自己的枚举重写了 SPOSCAR; 这里把 disp/force 矩阵按
# "SPOSCAR.ref -> SPOSCAR" 的原子映射做同一置换, 使数据与 pheasy 内部原子编号一致。
if [ "$ALIGN_DATA" = "true" ]; then
  echo "[1.5/4] 数据顺序对齐 (SPOSCAR.ref -> pheasy SPOSCAR)"
  python3 - <<'PYALIGN' || exit 1
import hashlib, json, os, pickle
import numpy as np
from phonopy.interface.vasp import read_vasp

def md5(p):
    with open(p, "rb") as fh:
        return hashlib.md5(fh.read()).hexdigest()

ref = read_vasp("SPOSCAR.ref")
cur = read_vasp("SPOSCAR")
if len(ref) != len(cur):
    raise SystemExit("[align] 原子数不同: SPOSCAR.ref=%d, SPOSCAR=%d" % (len(ref), len(cur)))
if not np.allclose(ref.cell, cur.cell, atol=1e-5):
    raise SystemExit("[align] 晶格不同, 两者不是同一超胞")
fr = ref.scaled_positions % 1.0
cr = cur.scaled_positions % 1.0
dd = cr[:, None, :] - fr[None, :, :]
dd -= np.round(dd)
dist = np.linalg.norm(dd @ cur.cell, axis=2)
sigma = dist.argmin(axis=1)
hit = dist[np.arange(len(sigma)), sigma]
if hit.max() > 1e-3:
    raise SystemExit("[align] 坐标匹配失败, 最大偏差 %.3e A" % hit.max())
if len(set(sigma.tolist())) != len(sigma):
    raise SystemExit("[align] 坐标匹配不是双射, SPOSCAR.ref 与 SPOSCAR 不是同一结构")
if not np.array_equal(np.asarray(ref.numbers), np.asarray(cur.numbers)[sigma]):
    raise SystemExit("[align] 匹配后元素种类不一致")
n = int((sigma != np.arange(len(sigma))).sum())

FILES = [f for f in ("disp_matrix.pkl", "force_matrix.pkl") if os.path.isfile(f)]
now = {f: md5(f) for f in FILES}
old = {}
if os.path.isfile(".pheasy_align.json"):
    try:
        old = json.load(open(".pheasy_align.json"))
    except Exception:
        old = {}
if FILES and old.get("post") == now:
    print("[align] 数据已按当前 SPOSCAR 排好 (需重排 %d/%d 个原子), 跳过" % (n, len(sigma)))
else:
    for f in FILES:
        a = pickle.load(open(f, "rb"))
        if a.ndim != 3 or a.shape[1] != len(sigma):
            raise SystemExit("[align] %s 形状 %s 与超胞原子数 %d 不匹配" % (f, a.shape, len(sigma)))
        pickle.dump(np.ascontiguousarray(a[:, sigma], dtype=np.float64), open(f, "wb"))
    if n:
        print("[align] 顺序不同 %d/%d 个原子 -> 已对 disp/force 矩阵施加同一置换" % (n, len(sigma)))
        print("[align] 受影响原子索引: %s" % np.nonzero(sigma != np.arange(len(sigma)))[0].tolist())
    else:
        print("[align] SPOSCAR.ref 与 pheasy SPOSCAR 顺序完全一致, 无需重排")
    json.dump({"n_moved": n, "sigma": sigma.tolist(), "pre": now,
               "post": {f: md5(f) for f in FILES},
               "sposcar_ref_md5": md5("SPOSCAR.ref"), "sposcar_md5": md5("SPOSCAR")},
              open(".pheasy_align.json", "w"), indent=2)
PYALIGN
fi

# ---------------- 二级指纹：数据（守 sensing matrix）---------------------------
# 必须在顺序对齐**之后**计算: 否则记录的是重排前的哈希, 下一次运行会误判"数据变了",
# 每次都丢弃 sensing matrix 重算。
_stamp_data=$(printf '%s | dtype=%s sm_ndata=%s disp=%s,%s force=%s,%s' \
  "$_stamp_struct" "$SM_DTYPE" "$SM_NDATA" \
  "$(stat -Lc %s disp_matrix.pkl)"  "$(_fp_hash disp_matrix.pkl)" \
  "$(stat -Lc %s force_matrix.pkl)" "$(_fp_hash force_matrix.pkl)")
if [ -f .pheasy_stamp_data ] && [ "$(cat .pheasy_stamp_data)" != "$_stamp_data" ]; then
  echo "位移/力数据或精度已变化，丢弃 sensing matrix："
  rm -f $_DATA_FILES
fi

if [ ! -f sm_prime.npz ]; then
  echo "[3/4] sensing matrix (按全部 $SM_NDATA 个构型建表, 供任意 NDATA<=$SM_NDATA 复用)"
  "$PHEASY_EXECUTABLE" --dim $DIM $W_FLAG -d $C_FLAG --ndata $SM_NDATA --disp_file --eps $NULL_SPACE_EPS || exit 1
else
  echo "[3/4] sensing matrix 跳过 (sm_prime.npz, 建表构型数 $SM_NDATA)"
fi
printf '%s' "$_stamp_data" > .pheasy_stamp_data

echo "[4/4] fit ($FIT_METHOD, ndata=$NDATA)"
FIT_FLAGS="--full_ifc -l $FIT_METHOD --hdf5 $RASR_FLAGS"
if [ "$FIX_FC2" = "true" ]; then
  # 2 阶保持稠密、只对 3 阶做稀疏, 避免把 FC2 剪到动力学失稳 (虚频)。
  FIT_FLAGS="$FIT_FLAGS --fix_fc2"
  if [ "$FIX_FC2_AUTO" = "true" ]; then
    export PHEASY_FIX_FC2_AUTO=1
  fi
fi
if [ "$HARM_DENSE" = "true" ]; then
  # 联合拟合, 但 HARM/FC2 的 L1 罚权为 0 -> FC2 稠密且仍参与重拟合。
  export PHEASY_HARM_DENSE=1
fi
# --std 对 LASSO / ALASSO / RIDGE 都生效。RIDGE 尤其需要：列范数跨度可达 1e2，
# 不标准化等于对不同项施加差百倍的 L2 惩罚。
if [ "$STANDARDIZE" = "true" ] && [[ "$FIT_METHOD" =~ ^(LASSO|ALASSO|RIDGE)$ ]]; then
  FIT_FLAGS="$FIT_FLAGS --std"
fi
if [[ "$FIT_METHOD" =~ ^(LASSO|ALASSO)$ ]]; then
  # --tol 0.001 不是"够紧"：sklearn 把 tol 按 ||y||^2 缩放, 小 alpha 端坐标下降
  # 远未收敛就停, CV 曲线在末端压平, argmin 在并列值里挑到最强正则的那个。
  if [ "$ALPHA_AUTO" = "false" ]; then
    FIT_FLAGS="$FIT_FLAGS --no-alpha_auto --mu_min $MU_MIN --mu_max $MU_MAX --nmu $NMU --max_iter $LASSO_MAX_ITER --cv $CV --tol $LASSO_TOL"
  else
    FIT_FLAGS="$FIT_FLAGS --alpha_auto --alpha_decades $ALPHA_DECADES --max_iter $LASSO_MAX_ITER --cv $CV --nmu $NMU --tol $LASSO_TOL"
  fi
elif [ "$FIT_METHOD" = "RIDGE" ]; then
  FIT_FLAGS="$FIT_FLAGS --mu_min $MU_MIN --mu_max $MU_MAX --nmu $NMU"
fi
# 力残差护栏: 拟合后打印的 Relative error 超过 REL_ERR_WARN 就醒目告警。
# 数据/结构顺序错标(约 0.10)、C2 截断过紧(约 0.05)、数据本身有问题, 都会在这里暴露。
"$PHEASY_EXECUTABLE" --dim $DIM $W_FLAG -f $C_FLAG --ndata $NDATA --eps $NULL_SPACE_EPS $FIT_FLAGS 2>&1 \
| awk -v t="${REL_ERR_WARN:-0}" '
    { print }
    /Relative error:/ {
      v = $NF + 0
      if (t + 0 > 0 && v > t + 0) {
        printf "\n[!!! 警告] 力残差相对误差 %.4f 超过阈值 %.4f\n", v, t
        printf "[!!! 警告] 经验值: 数据顺序错标约 0.10 / fc2 截断过紧约 0.05 / 正常应 < 0.02\n"
        printf "[!!! 警告] 请检查 SPOSCAR.ref 与 pheasy 写出的 SPOSCAR 是否一致(本脚本自动对齐),\n"
        printf "[!!! 警告] 以及 C2_CUTOFF 是否过小。\n\n"
      }
    }' || exit 1

echo "完成"
python3 -c "
import h5py, numpy as np
for fn, keys in (('fc2.hdf5', ('fc2', 'force_constants')),
                 ('fc3.hdf5', ('fc3', 'force_constants_third')),
                 ('fc4.hdf5', ('fc4', 'force_constants_fourth'))):
    try:
        with h5py.File(fn, 'r') as f:
            k = next(k for k in keys if k in f)
            print('%-9s max = %.4f' % (k, float(np.max(np.abs(np.asarray(f[k]))))))
    except (OSError, StopIteration):
        pass
" || exit 1

# =============================================================================
# [4.5/4] 输出力常数顺序回填 (v5): pheasy 序 -> SPOSCAR.ref(数据/下游)序
# =============================================================================
# pheasy 用自己的枚举重建超胞并重写 SPOSCAR, --full_ifc 写出的 fc2/fc3/fc4 也在
# 它自己的原子序里; 而数据与下游 (phono3py / hiphive / ShengBTE / κ) 认的是
# SPOSCAR.ref 的序。只对齐输入不对齐输出 = 力常数错序: 力残差/RMSE 完全正常,
# 但 κ 会静默偏几十个百分点 (Mn2In2Se5 3x3x1 实测 κxx 1.503 vs 1.147)。
# 这里按 .pheasy_align.json 的 sigma 把每个原子轴置换回去; 结果记在
# .pheasy_fc_permuted.json, fit 被指纹跳过时重跑不会二次置换 (幂等)。
if [ "${ALIGN_OUTPUT:-true}" = "true" ] && [ -f .pheasy_align.json ]; then
  echo "[4.5/4] 输出力常数顺序回填 (pheasy 序 -> SPOSCAR.ref 序)"
  python3 - <<'PYPERM' || exit 1
import json, os, sys, hashlib
import numpy as np
try:
    import h5py
except ImportError:
    print("[perm] 无 h5py, 跳过"); sys.exit(0)

rec = json.load(open(".pheasy_align.json", encoding="utf-8"))
sig = np.asarray(rec.get("sigma", []), dtype=int)
if sig.size == 0:
    print("[perm] .pheasy_align.json 无 sigma, 跳过"); sys.exit(0)
ns = int(sig.size)
sinv = np.argsort(sig)
sig_md5 = hashlib.md5(sig.astype("<i8").tobytes()).hexdigest()[:12]
n_moved = int((sig != np.arange(ns)).sum())
if n_moved == 0:
    print("[perm] 数据与 pheasy 顺序一致 (n_moved=0), 无需回填"); sys.exit(0)

FLAG = ".pheasy_fc_permuted.json"
state = {}
if os.path.exists(FLAG):
    try:
        state = json.load(open(FLAG, encoding="utf-8"))
    except Exception:
        state = {}

KEYS = {"fc2.hdf5": ("fc2", "force_constants"),
        "fc3.hdf5": ("fc3", "force_constants_third"),
        "fc4.hdf5": ("fc4", "force_constants_fourth")}

def _md5(fn):
    h = hashlib.md5()
    with h5py.File(fn, "r") as fh:
        for k in sorted(fh.keys()):
            if k == "version":
                continue
            h.update(np.ascontiguousarray(fh[k][()]).tobytes())
    return h.hexdigest()[:12]

new_state = {"sigma_md5": sig_md5, "n_moved": n_moved, "files": {}}
for fn, keys in KEYS.items():
    if not os.path.exists(fn):
        continue
    cur = _md5(fn)
    old = (state.get("files") or {}).get(fn) or {}
    if old.get("post_md5") == cur and state.get("sigma_md5") == sig_md5:
        print("[perm] %s 已回填 (post_md5 %s), 跳过" % (fn, cur))
        new_state["files"][fn] = old
        continue
    with h5py.File(fn, "r+") as fh:
        key = next(k for k in keys if k in fh)
        arr = np.asarray(fh[key])
        if arr.ndim == 0:
            new_state["files"][fn] = old
            continue
        if arr.shape[0] == ns:
            nax = arr.ndim // 2
            out = np.take(arr, sinv, axis=0)
            for ax in range(1, nax):
                out = np.take(out, sinv, axis=ax)
            fh[key][...] = out
        elif "p2s_map" in fh and arr.ndim in (4, 6, 8):
            p2s = np.asarray(fh["p2s_map"])
            nax = arr.ndim // 2
            full = np.zeros((ns,) + arr.shape[1:], dtype=arr.dtype)
            for a in range(arr.shape[0]):
                full[int(p2s[a])] = arr[a]
            out = np.take(full, sinv, axis=0)
            for ax in range(1, nax):
                out = np.take(out, sinv, axis=ax)
            del fh[key]
            fh.create_dataset(key, data=np.ascontiguousarray(out), compression="gzip")
            print("[perm] %s 原为 compact, 已按 full 写回" % fn)
        else:
            print("[perm][WARN] %s shape %s 无法识别原子轴, 跳过" % (fn, arr.shape))
            new_state["files"][fn] = old
            continue
    new_state["files"][fn] = {"pre_md5": cur, "post_md5": _md5(fn)}
    print("[perm] %s 已回填: %d/%d 个原子移动 -> SPOSCAR.ref 序" % (fn, n_moved, ns))

json.dump(new_state, open(FLAG, "w", encoding="utf-8"), indent=2, sort_keys=True)
print("[perm] 记录写入 %s" % FLAG)
PYPERM
else
  echo "[4.5/4] 跳过输出顺序回填 (ALIGN_OUTPUT=${ALIGN_OUTPUT:-true}, align.json=$([ -f .pheasy_align.json ] && echo 有 || echo 无))"
fi
